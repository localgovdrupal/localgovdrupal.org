{% extends "@localgov_base/templates/layout/page.html.twig" %}

{% block header %}
  {% include '@lgd_org_theme/templates/layout/header.html.twig' with {'page': page} %}
{% endblock %}

{% block post_footer %}
  {% if has_lower_footer_first or has_lower_footer_second or has_lower_footer_third %}
    <div class="lgd-footer__post-footer">
      <div class="lgd-container">
        <div class="lgd-row">
          {% if has_lower_footer_first %}
            <div class="lgd-row">
              {{ page.lower_footer_first }}
            </div>
          {% endif %}

          {% if has_lower_footer_second %}
            <div class="lgd-row">
              {{ page.lower_footer_second }}
            </div>
          {% endif %}

          {% if has_lower_footer_third %}
            <div class="lgd-row">
              {{ page.lower_footer_third }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
{% endblock %}

