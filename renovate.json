{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlertsWithLabel('security')"
  ],
  "reviewers": [
    "stephen-cox"
  ],
  "branchPrefix": "renovate/",
  "rangeStrategy": "update-lockfile",
  "packageRules": [
    {
      "groupName": "Skip major updates",
      "matchManagers": [
        "composer"
      ],
      "matchDatasources": [
        "packagist"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/.*/"
      ]
    },
    {
      "groupName": "Contrib",
      "groupSlug": "contrib",
      "matchManagers": [
        "composer"
      ],
      "matchDatasources": [
        "packagist"
      ],
      "separateMinorPatch": false,
      "matchPackageNames": [
        "/.*/",
        "!drupal/core-composer-scaffold",
        "!drupal/core-project-message",
        "!drupal/core-recommended",
        "!drupal/core-dev"
      ]
    },
    {
      "groupName": "Drupal Core",
      "groupSlug": "drupal-core",
      "matchManagers": [
        "composer"
      ],
      "matchDatasources": [
        "packagist"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchPackageNames": [
        "drupal/core-composer-scaffold",
        "drupal/core-project-message",
        "drupal/core-recommended",
        "drupal/core-dev"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    }
  ]
}
