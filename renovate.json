{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlertsWithLabel('security')"
  ],
  "reviewers": ["stephen-cox"],
  "branchPrefix": "renovate/",
  "packageRules": [
    {
      "groupName": "Drupal core",
      "matchManagers": ["composer"],
      "matchFileNames": ["composer.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["drupal/core-**"]
    },
    {
      "groupName": "Drupal contributed modules",
      "matchManagers": ["composer"],
      "matchFileNames": ["composer.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["drupal/**", "!drupal/core-**"]
    },
    {
      "groupName": "LocalGov Drupal",
      "matchManagers": ["composer"],
      "matchFileNames": ["composer.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["localgovdrupal/**"]
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true
    }
  ]
}
